---
// src/pages/work/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { careerItems } from '../../data/career';

const { slug } = Astro.params;
const jobIndex = careerItems.findIndex((j) => j.slug === slug);

if (jobIndex === -1) {
  return Astro.redirect('/work');
}

const job = careerItems[jobIndex];
const prevJob = jobIndex > 0 ? careerItems[jobIndex - 1] : careerItems[careerItems.length - 1];
const nextJob = jobIndex < careerItems.length - 1 ? careerItems[jobIndex + 1] : careerItems[0];
---

<BaseLayout
  title={`${job.company} — ${job.role} | Career Case Study`}
  description={job.summary}
  image={job.image}
>
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Breadcrumbs -->
    <div class="flex items-center justify-between gap-4 font-mono text-xs text-mono-400">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-mono-100 transition-colors">Home</a>
        <span>/</span>
        <a href="/work" class="hover:text-mono-100 transition-colors">Career & Work</a>
        <span>/</span>
        <span class="text-accent truncate max-w-xs sm:max-w-md">{job.company}</span>
      </div>

      <a
        href="/work"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-mono-900 hover:bg-mono-800 text-mono-300 hover:text-mono-100 border border-mono-800 transition-all"
      >
        <span>←</span>
        <span>Back to All 19</span>
      </a>
    </div>

    <!-- Hero Header -->
    <div class="glass-card rounded-2xl p-6 sm:p-10 border-mono-800 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 flex-wrap">
          <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-mono-950 text-mono-200 border border-mono-700">
            {job.domainLabel}
          </span>
          {job.location && (
            <span class="text-xs font-mono text-mono-400">
              📍 {job.location}
            </span>
          )}
        </div>

        {job.patent && (
          <div class="px-3 py-1 rounded-xl bg-amber-500/20 text-gold-300 border border-amber-500/50 text-xs font-mono font-bold flex items-center gap-1.5">
            <span>★</span>
            <span>US Patent Awarded ({job.patent.year})</span>
          </div>
        )}
      </div>

      <div>
        <h1 class="text-3xl sm:text-5xl font-black font-mono text-mono-50 tracking-tight">
          {job.company}
        </h1>
        <div class="text-base sm:text-xl font-mono text-accent font-semibold mt-1">
          {job.role}
        </div>
      </div>

      <p class="text-base sm:text-lg text-mono-200 leading-relaxed font-sans max-w-3xl">
        {job.summary}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2 border-t border-mono-800/60">
        {job.tags.map((tag) => (
          <span class="text-xs font-mono px-2.5 py-1 rounded bg-mono-900 text-mono-300 border border-mono-800">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Visual Media Showcase -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="glass-card rounded-2xl overflow-hidden p-3 border-mono-800 bg-mono-950">
        <img
          src={job.image}
          alt={job.title}
          class="w-full h-80 object-cover rounded-xl"
          onerror="this.src='/img/hilliard-logo4.png'; this.classList.add('object-contain', 'p-8');"
        />
        <div class="p-3 text-center text-xs font-mono text-mono-400">
          Primary Archive Artifact: {job.title}
        </div>
      </div>

      {job.heroImage && (
        <div class="glass-card rounded-2xl overflow-hidden p-3 border-mono-800 bg-mono-950">
          <img
            src={job.heroImage}
            alt={`${job.company} Context`}
            class="w-full h-80 object-cover rounded-xl"
            onerror="this.src='/img/hilliard-logo4.png'; this.classList.add('object-contain', 'p-8');"
          />
          <div class="p-3 text-center text-xs font-mono text-mono-400">
            {job.domain === 'athletics-music-community'
              ? 'Performance, Rink & Community Environment'
              : 'System & Engineering Environment'}
          </div>
        </div>
      )}
    </div>

    <!-- Narrative & Case Study Content -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Left: In-depth Story -->
      <div class="md:col-span-7 glass-card rounded-2xl p-6 sm:p-8 space-y-6">
        <h2 class="text-xl font-bold font-mono text-mono-50 tracking-tight border-b border-mono-800/80 pb-3">
          {job.contentTitle}
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-mono-300 leading-relaxed font-sans">
          {job.content.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <!-- Right: Key Achievements / Impacts -->
      <div class="md:col-span-5 glass-card rounded-2xl p-6 sm:p-8 space-y-5">
        <h2 class="text-lg font-bold font-mono text-mono-50 tracking-tight border-b border-mono-800/80 pb-3">
          {job.slug === 'hockey-coaching'
            ? 'Key Coaching & Leadership Achievements'
            : job.slug === 'goalie-stopper'
            ? 'Key STOPPER Tenets & Crease Milestones'
            : job.slug === 'musician-bass'
            ? 'Key Musical & Craftsmanship Highlights'
            : job.slug === 'kgnu-radio'
            ? 'Key Broadcasting & Community Highlights'
            : job.domain === 'athletics-music-community'
            ? 'Key Coaching & Athletic Achievements'
            : 'Key Engineering & Architectural Impacts'}
        </h2>
        {job.achievements && job.achievements.length > 0 ? (
          <ul class="space-y-3 text-xs font-mono text-mono-300">
            {job.achievements.map((achievement) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent shrink-0 font-bold">▸</span>
                <span class="leading-relaxed">{achievement}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs font-mono text-mono-400">
            Delivered enterprise-grade systems architecture, QA automation, and high reliability standards.
          </p>
        )}

        {job.patent && (
          <div class="mt-6 pt-4 border-t border-mono-800 space-y-2">
            <div class="text-xs font-mono text-gold-400 font-bold uppercase tracking-wider">
              Patent Details
            </div>
            <p class="text-xs text-mono-300">
              {job.patent.title} — Awarded {job.patent.year}
            </p>
          </div>
        )}
      </div>
    </div>

    <!-- Pagination -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-mono-800">
      <a
        href={`/work/${prevJob.slug}`}
        class="glass-card p-4 rounded-xl hover:border-accent transition-all group flex flex-col justify-between"
      >
        <span class="text-[10px] font-mono text-mono-400">← PREVIOUS MILESTONE</span>
        <span class="text-sm font-mono font-bold text-mono-100 group-hover:text-accent transition-colors truncate mt-1">
          {prevJob.company} — {prevJob.role}
        </span>
      </a>

      <a
        href={`/work/${nextJob.slug}`}
        class="glass-card p-4 rounded-xl hover:border-accent transition-all group flex flex-col justify-between text-left sm:text-right"
      >
        <span class="text-[10px] font-mono text-mono-400">NEXT MILESTONE →</span>
        <span class="text-sm font-mono font-bold text-mono-100 group-hover:text-accent transition-colors truncate mt-1">
          {nextJob.company} — {nextJob.role}
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
