---
// src/pages/resume.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerItems } from '../data/career';
import { certifications } from '../data/certifications';
import { bioStats } from '../data/philosophy';
---

<BaseLayout
  title="Interactive Resume Replacement | Hilliard M. Scott"
  description="Comprehensive interactive resume and executive qualifications for Hilliard M. Scott: Hardware Engineer, Software Architect, US Patent Holder, and Founder."
>
  <div class="max-w-4xl mx-auto space-y-8 resume-container">
    <!-- Top Action Bar (Hidden in Print) -->
    <div class="no-print glass-card rounded-2xl p-4 sm:p-6 border-mono-800 flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="text-xs font-mono text-accent uppercase tracking-widest font-bold">
          ● EXECUTIVE QUALIFICATIONS
        </div>
        <h1 class="text-xl sm:text-2xl font-bold font-mono text-mono-50">
          Resume Replacement Document
        </h1>
      </div>

      <div class="flex items-center gap-3 font-mono text-xs">
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-accent hover:bg-gold-400 text-mono-950 font-bold shadow-md shadow-accent/20 transition-all cursor-pointer"
        >
          <span>🖨️ Print / Save as PDF</span>
        </button>

        <a
          href="mailto:hilliards@gmail.com?subject=Portfolio%20Inquiry%20-%20Hilliard%20Scott"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-mono-900 hover:bg-mono-800 text-mono-100 border border-mono-700 transition-all"
        >
          <span>✉ Hire / Inquire</span>
        </a>
      </div>
    </div>

    <!-- MAIN RESUME DOCUMENT (Print-friendly layout) -->
    <div class="glass-card rounded-2xl p-6 sm:p-12 border-mono-800 space-y-10 bg-mono-950/90 text-mono-50">
      <!-- Header / Contact Info -->
      <div class="border-b border-mono-800/80 pb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-6">
        <div>
          <h1 class="text-3xl sm:text-4xl font-black font-mono tracking-tight text-mono-50">
            HILLIARD M. SCOTT
          </h1>
          <div class="text-base font-mono text-accent font-semibold mt-1">
            Software Architect • Hardware Engineer • US Patent Holder • Founder
          </div>
          <p class="text-xs font-mono text-mono-400 mt-2">
            Westminster, Colorado • Available for Strategic Technical Advisory & Senior Leadership
          </p>
        </div>

        <div class="font-mono text-xs text-mono-300 space-y-1 text-left sm:text-right shrink-0">
          <div><a href="mailto:hilliards@gmail.com" class="hover:text-accent">hilliards@gmail.com</a></div>
          <div><a href="https://linkedin.com" target="_blank" class="hover:text-accent">linkedin.com/in/hilliard-scott</a></div>
          <div><a href="https://github.com" target="_blank" class="hover:text-accent">github.com</a></div>
          <div class="text-mono-400">Westminster, CO 80031</div>
        </div>
      </div>

      <!-- Executive Summary -->
      <section class="space-y-3">
        <h2 class="text-xs font-mono text-accent uppercase tracking-widest font-bold border-b border-mono-800/60 pb-1">
          EXECUTIVE SUMMARY
        </h2>
        <p class="text-sm text-mono-200 leading-relaxed font-sans">
          Visionary multi-disciplinary engineer with over {bioStats.yearsExperience} years of experience architecting high-reliability systems from the silicon level to modern cloud platforms and artificial intelligence. Co-founder of 3 successful technology ventures and granted a United States Patent for innovative automated storage mechanisms. Proven leadership spanning aerospace power design for the NASA Space Shuttle, robotic enterprise tape systems (StorageTek), large-scale transactional e-commerce (ClickBank), developer extensibility platforms (SketchUp/Trimble), and international hydrological decision support systems (World Bank).
        </p>
      </section>

      <!-- Core Competencies Grid -->
      <section class="space-y-3">
        <h2 class="text-xs font-mono text-accent uppercase tracking-widest font-bold border-b border-mono-800/60 pb-1">
          CORE COMPETENCIES & EXPERTISE
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs font-mono">
          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <div class="font-bold text-mono-100 mb-1">Architecture & Systems</div>
            <div class="text-mono-400">Distributed Cloud, Microservices, Event-driven systems, REST/GraphQL, Database modeling</div>
          </div>

          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <div class="font-bold text-mono-100 mb-1">AI & Machine Learning</div>
            <div class="text-mono-400">Neural Networks, RAG architectures, Model Context Protocol (MCP), Autonomous AI Agents</div>
          </div>

          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <div class="font-bold text-mono-100 mb-1">Hardware & Firmware</div>
            <div class="text-mono-400">Power electronics, SCSI/Fibre Channel, tape automation, embedded firmware, Mil-Spec testing</div>
          </div>

          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <div class="font-bold text-mono-100 mb-1">Quality & Leadership</div>
            <div class="text-mono-400">Agile QA management, automated test frameworks, CI/CD pipelines, zero-defect release management</div>
          </div>

          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <div class="font-bold text-mono-100 mb-1">Modern Web Stack</div>
            <div class="text-mono-400">Astro, TypeScript, React, Next.js, Node.js, Express, Tailwind CSS, PostgreSQL, Supabase</div>
          </div>

          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <div class="font-bold text-mono-100 mb-1">Intellectual Property</div>
            <div class="text-mono-400">US Patent 1999 Holder, technical whitepapers, architectural decision records (ADRs)</div>
          </div>
        </div>
      </section>

      <!-- Professional Career Timeline -->
      <section class="space-y-6">
        <h2 class="text-xs font-mono text-accent uppercase tracking-widest font-bold border-b border-mono-800/60 pb-1">
          PROFESSIONAL EXPERIENCE
        </h2>

        <div class="space-y-8">
          {careerItems.map((job) => (
            <div class="space-y-2.5">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div>
                  <h3 class="text-base font-bold font-mono text-mono-100">
                    {job.role}
                  </h3>
                  <div class="text-xs font-mono text-accent font-semibold">
                    {job.company} {job.location ? `• ${job.location}` : ''}
                  </div>
                </div>
                {job.patent && (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-gold-300 border border-amber-500/40 shrink-0">
                    ★ US Patent Awarded
                  </span>
                )}
              </div>

              <p class="text-xs text-mono-300 leading-relaxed font-sans">
                {job.summary}
              </p>

              {job.achievements && job.achievements.length > 0 && (
                <ul class="space-y-1 text-xs font-mono text-mono-400 pl-2">
                  {job.achievements.map((ach) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent shrink-0">▸</span>
                      <span>{ach}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Patents & Specialized Credentials -->
      <section class="space-y-3">
        <h2 class="text-xs font-mono text-accent uppercase tracking-widest font-bold border-b border-mono-800/60 pb-1">
          PATENTS & SPECIALIZED CREDENTIALS
        </h2>
        <div class="space-y-2 text-xs font-mono text-mono-300">
          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <span class="font-bold text-mono-100">United States Patent (1999)</span> — Automated digital tape storage mechanism and drive systems (DataSonix / Pereos).
          </div>
          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <span class="font-bold text-mono-100">University of Colorado Colorado Springs (UCCS)</span> — Postgraduate Certificate in Artificial Intelligence & Neural Networks.
          </div>
          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <span class="font-bold text-mono-100">USA Hockey Level 5 Master Coaching Credential</span> — International Silver Stick Champion, State Champion, Collegiate Nationals Coach.
          </div>
          <div class="p-3 rounded-lg bg-mono-900/60 border border-mono-800">
            <span class="font-bold text-mono-100">49+ Recent Software & AI Certifications (Acquired in Last 2 Years)</span> — Fullstack, TypeScript, Astro, Next.js, Model Context Protocol (MCP), AI Agents.
          </div>
        </div>
      </section>

      <!-- Call to Action in Resume -->
      <div class="no-print pt-6 border-t border-mono-800/80 text-center space-y-4">
        <p class="text-xs font-mono text-mono-400">
          Interested in discussing consulting, technical advisory, or senior engineering roles?
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-gold-500 to-amber-600 text-mono-950 font-bold font-mono text-xs shadow-lg shadow-gold-500/20"
        >
          <span>Get in Touch with Hilliard</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
