---
// src/pages/philosophy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { engineeringPrinciples, bioStats } from '../data/philosophy';
---

<BaseLayout
  title="Engineering Philosophy & STOPPER Mindset | Hilliard M. Scott"
  description="Explore Hilliard M. Scott's software engineering philosophy, hardware-software bridge, zero-defect quality mindset, and the STOPPER goalie gladiator framework."
>
  <div class="max-w-5xl mx-auto space-y-16">
    <!-- Header Hero -->
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-accent uppercase tracking-widest font-bold">
        <span>●</span> CORE BELIEFS & ARCHITECTURAL TENETS
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-mono text-mono-50 tracking-tight">
        Engineering Philosophy & The STOPPER Mindset
      </h1>
      <p class="text-sm sm:text-base text-mono-300 leading-relaxed font-sans">
        Software is not merely abstract syntax; it is the coordination of energy through physical silicon to solve human problems. My philosophy is forged across aerospace hardware, enterprise data storage, US patent innovations, and championship athletic coaching.
      </p>
    </div>

    <!-- 4 Core Tenets -->
    <div class="space-y-12">
      {engineeringPrinciples.map((principle, index) => (
        <section class="glass-card rounded-2xl p-6 sm:p-10 border-mono-800 space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-accent/20 text-accent font-mono font-bold flex items-center justify-center text-sm border border-accent/40">
                0{index + 1}
              </span>
              <div>
                <h2 class="text-xl sm:text-2xl font-bold font-mono text-mono-50 tracking-tight">
                  {principle.title}
                </h2>
                <div class="text-xs font-mono text-accent font-semibold">
                  {principle.subtitle}
                </div>
              </div>
            </div>
          </div>

          <!-- Quote Callout -->
          <blockquote class="p-4 rounded-xl bg-mono-900/80 border-l-4 border-accent text-sm sm:text-base font-mono text-mono-100 italic">
            "{principle.quote}"
          </blockquote>

          <p class="text-sm sm:text-base text-mono-300 leading-relaxed font-sans">
            {principle.description}
          </p>

          <!-- Bullets -->
          <div class="pt-4 border-t border-mono-800/80">
            <div class="text-xs font-mono text-mono-400 uppercase tracking-wider mb-3 font-semibold">
              Core Principles in Action
            </div>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm font-mono text-mono-300">
              {principle.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5 p-3 rounded-lg bg-mono-950/60 border border-mono-800/80">
                  <span class="text-accent shrink-0 font-bold">▸</span>
                  <span class="leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <!-- The STOPPER Deep-Dive Feature Box -->
    <section class="glass-card bg-gradient-to-br from-mono-900 via-mono-950 to-mono-900 rounded-2xl p-8 sm:p-12 border-accent/40 space-y-6">
      <div class="text-xs font-mono text-gold-400 uppercase tracking-widest font-bold">
        ★ THE GLADIATOR'S PLAYBOOK
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold font-mono text-mono-50">
        Why the Goalie Mindset Makes Better Software Architects
      </h2>
      <div class="space-y-4 text-sm text-mono-300 leading-relaxed font-sans">
        <p>
          In team sports, goalies are the only players whose errors are immediately visible on the scoreboard. They don't score goals, but they prevent defeat. They must manage immense pressure, analyze rapid movement, and remain calm when the game accelerates.
        </p>
        <p>
          As software architects and engineering leaders, we play the exact same role. When cloud dependencies fail, database connections spike, or edge networks hiccup — the architecture must act as the ultimate STOPPER: graceful degradation, fault isolation, and uninterrupted uptime.
        </p>
      </div>

      <div class="pt-4 flex flex-wrap gap-4 font-mono text-xs">
        <a href="/work/goalie-stopper" class="px-4 py-2 rounded-lg bg-accent text-mono-950 font-bold hover:bg-gold-400 transition-all">
          Explore Goalie History & Story →
        </a>
        <a href="/work/hockey-coaching" class="px-4 py-2 rounded-lg bg-mono-900 text-mono-200 border border-mono-700 hover:text-mono-50 transition-all">
          View USA Hockey Championship Credentials →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
