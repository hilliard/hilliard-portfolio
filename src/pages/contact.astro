---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact & Technical Consultation | Hilliard M. Scott"
  description="Get in touch with Hilliard M. Scott for strategic software & hardware advisory, AI architecture, and engineering consultation."
>
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Header -->
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-accent uppercase tracking-widest font-bold">
        <span>●</span> DIRECT CONSULTATION & ADVISORY
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-mono text-mono-50 tracking-tight">
        Let's Build Something Resilient
      </h1>
      <p class="text-sm sm:text-base text-mono-300 leading-relaxed font-sans">
        Whether you are seeking strategic technical advisory for an emerging startup, hardware-software co-design, full-stack architecture, or AI engineering direction — I welcome the conversation.
      </p>
    </div>

    <!-- Contact Info Cards + Form Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left Column: Contact Details & Areas of Advisory -->
      <div class="lg:col-span-5 space-y-6">
        <div class="glass-card rounded-2xl p-6 border-mono-800 space-y-4">
          <h2 class="text-base font-bold font-mono text-mono-100">
            Contact Information
          </h2>

          <div class="space-y-3 text-xs font-mono text-mono-300">
            <div>
              <div class="text-mono-400 text-[10px] uppercase tracking-wider">Direct Email</div>
              <a href="mailto:hilliards@gmail.com" class="text-accent hover:underline font-bold text-sm">
                hilliards@gmail.com
              </a>
            </div>

            <div>
              <div class="text-mono-400 text-[10px] uppercase tracking-wider">Location</div>
              <div class="text-mono-100 font-medium">Westminster, Colorado (Front Range)</div>
            </div>

            <div>
              <div class="text-mono-400 text-[10px] uppercase tracking-wider">Company</div>
              <div class="text-mono-100 font-medium">GoldTending Incorporated</div>
            </div>

            <div>
              <div class="text-mono-400 text-[10px] uppercase tracking-wider">Availability</div>
              <div class="flex items-center gap-2 text-emerald-400 font-semibold">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Open for Advisory & Senior Engineering Roles</span>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card rounded-2xl p-6 border-mono-800 space-y-3">
          <h2 class="text-sm font-bold font-mono text-accent uppercase tracking-wider">
            Areas of Advisory & Consulting
          </h2>
          <ul class="space-y-2 text-xs font-mono text-mono-300">
            <li class="flex items-start gap-2">
              <span class="text-accent shrink-0 font-bold">▸</span>
              <span>Hardware-Software Co-Design & Embedded Storage Systems</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent shrink-0 font-bold">▸</span>
              <span>Fullstack Web Architecture (Astro, TypeScript, Next.js, Node)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent shrink-0 font-bold">▸</span>
              <span>Model Context Protocol (MCP) & Autonomous AI Agent Integration</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent shrink-0 font-bold">▸</span>
              <span>Quality Assurance Strategy, Test Automation & Fault Tolerance</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>
    </div>
  </div>
</BaseLayout>
