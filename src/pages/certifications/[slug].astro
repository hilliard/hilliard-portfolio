---
// src/pages/certifications/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { certifications } from '../../data/certifications';

const { slug } = Astro.params;
const certIndex = certifications.findIndex((c) => c.slug === slug);

if (certIndex === -1) {
  return Astro.redirect('/certifications');
}

const cert = certifications[certIndex];
const prevCert = certIndex > 0 ? certifications[certIndex - 1] : certifications[certifications.length - 1];
const nextCert = certIndex < certifications.length - 1 ? certifications[certIndex + 1] : certifications[0];
---

<BaseLayout
  title={`${cert.title} | Certification Details`}
  description={cert.summary}
  image={cert.image}
>
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Breadcrumbs & Navigation -->
    <div class="flex items-center justify-between gap-4 font-mono text-xs text-mono-400">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-mono-100 transition-colors">Home</a>
        <span>/</span>
        <a href="/certifications" class="hover:text-mono-100 transition-colors">Certifications</a>
        <span>/</span>
        <span class="text-accent truncate max-w-xs sm:max-w-md">{cert.title}</span>
      </div>

      <a
        href="/certifications"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-mono-900 hover:bg-mono-800 text-mono-300 hover:text-mono-100 border border-mono-800 transition-all"
      >
        <span>←</span>
        <span>Back to All 49</span>
      </a>
    </div>

    <!-- Main Certificate Hero Banner -->
    <div class="glass-card rounded-2xl p-6 sm:p-10 border-mono-800 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-mono-950 text-mono-200 border border-mono-700">
            {cert.provider}
          </span>
          <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-accent/20 text-accent border border-accent/40">
            {cert.categoryLabel}
          </span>
        </div>

        {cert.pdf && (
          <a
            href={cert.pdf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-accent hover:bg-gold-400 text-mono-950 font-mono text-xs font-bold shadow-md shadow-accent/20 transition-all"
          >
            <span>📜 View Certificate PDF</span>
            <span>↗</span>
          </a>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black font-mono text-mono-50 tracking-tight leading-tight">
        {cert.title}
      </h1>

      <p class="text-base sm:text-lg text-mono-200 leading-relaxed font-sans max-w-3xl">
        {cert.summary}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2 border-t border-mono-800/60">
        {cert.tags.map((tag) => (
          <span class="text-xs font-mono px-2.5 py-1 rounded bg-mono-900 text-mono-300 border border-mono-800">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Certificate Visual Showcase -->
    <div class="glass-card rounded-2xl p-4 sm:p-8 border-mono-800 space-y-8">
      <div class="text-xs font-mono text-accent uppercase tracking-widest font-bold">
        ● VERIFIED CREDENTIAL DOCUMENTATION
      </div>

      <div class="rounded-xl overflow-hidden border border-mono-800 bg-mono-950 shadow-2xl">
        <img
          src={cert.image}
          alt={cert.title}
          class="w-full h-auto object-contain max-h-[700px] mx-auto"
          onerror="this.src='/img/hilliard-logo4.png'; this.classList.add('p-12');"
        />
      </div>

      <!-- Secondary Illustrative Image (if available) -->
      {cert.secondaryImage && (
        <div class="rounded-xl overflow-hidden border border-mono-800 bg-mono-950 mt-6">
          <img
            src={cert.secondaryImage}
            alt={`${cert.title} Illustrative Concept`}
            class="w-full h-auto object-cover max-h-[400px]"
          />
        </div>
      )}
    </div>

    <!-- Comprehensive Curriculum & Syllabus -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Description Paragraphs -->
      <div class="md:col-span-7 glass-card rounded-2xl p-6 sm:p-8 space-y-4">
        <h2 class="text-lg font-bold font-mono text-mono-50 tracking-tight border-b border-mono-800/80 pb-3">
          Curriculum Overview
        </h2>
        <div class="space-y-4 text-sm text-mono-300 leading-relaxed font-sans">
          {cert.descriptions.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <!-- Syllabus Topics Bullets -->
      <div class="md:col-span-5 glass-card rounded-2xl p-6 sm:p-8 space-y-4">
        <h2 class="text-lg font-bold font-mono text-mono-50 tracking-tight border-b border-mono-800/80 pb-3">
          Topics & Skills Mastered
        </h2>
        {cert.skills.length > 0 ? (
          <ul class="space-y-2 text-xs font-mono text-mono-300">
            {cert.skills.map((skill) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent shrink-0 font-bold">✓</span>
                <span class="leading-relaxed">{skill}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs font-mono text-mono-400">
            Verified mastery across core industry standards and modern development tooling.
          </p>
        )}
      </div>
    </div>

    <!-- Next / Prev Pagination -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-mono-800">
      <a
        href={`/certifications/${prevCert.slug}`}
        class="glass-card p-4 rounded-xl hover:border-accent transition-all group flex flex-col justify-between"
      >
        <span class="text-[10px] font-mono text-mono-400">← PREVIOUS CERTIFICATE</span>
        <span class="text-sm font-mono font-bold text-mono-100 group-hover:text-accent transition-colors truncate mt-1">
          {prevCert.title}
        </span>
      </a>

      <a
        href={`/certifications/${nextCert.slug}`}
        class="glass-card p-4 rounded-xl hover:border-accent transition-all group flex flex-col justify-between text-left sm:text-right"
      >
        <span class="text-[10px] font-mono text-mono-400">NEXT CERTIFICATE →</span>
        <span class="text-sm font-mono font-bold text-mono-100 group-hover:text-accent transition-colors truncate mt-1">
          {nextCert.title}
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
